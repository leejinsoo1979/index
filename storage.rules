rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Seminar posters/gallery: public read, admin upload (images under 5MB).
    match /seminars/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['sbbc212@gmail.com']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /agent-studio/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // ARCHI Agent Studio files (images, knowledge uploads, exports).
    match /archi-studio/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
