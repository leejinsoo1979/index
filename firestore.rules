rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Super admins: keep in sync with ADMIN_EMAILS (src/lib/adminStore.ts, api/*). They can never be
    // demoted from the admin screen. Further admins are granted in /admin/members (members/{uid}.role).
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['sbbc212@gmail.com'];
    }
    function memberDoc(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }
    function isAdmin() {
      return isSuperAdmin()
        || (request.auth != null
          && exists(memberDoc(request.auth.uid))
          && get(memberDoc(request.auth.uid)).data.get('role', '') == 'admin'
          && get(memberDoc(request.auth.uid)).data.get('status', 'active') != 'suspended');
    }

    function seminarDoc(id) {
      return /databases/$(database)/documents/seminars/$(id);
    }
    function applicationDoc(id) {
      return /databases/$(database)/documents/seminarApplications/$(id);
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Curriculum builder: the module library is public reference data; courses are
    // public once published. Only admins write either.
    match /curriculumModules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /curricula/{curriculumId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Interactive flipbooks: the link works once published; admins make and preview them.
    match /flipbooks/{bookId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Seminars: public when published; admins edit everything except the seat counter,
    // which changes only together with an application (see seminarApplications).
    match /seminars/{seminarId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && request.resource.data.enrolled == 0;
      allow delete: if isAdmin();
      allow update: if
        (isAdmin() && (request.resource.data.enrolled == resource.data.enrolled || onlyChanged(['enrolled'])))
        || (request.auth != null && onlyChanged(['enrolled']) && (
          // member takes a seat: own application becomes APPLIED in the same write, within capacity, while open
          (request.resource.data.enrolled == resource.data.enrolled + 1
            && request.resource.data.enrolled <= resource.data.capacity
            && resource.data.published == true
            && resource.data.status == '접수중'
            && getAfter(applicationDoc(seminarId + '__' + request.auth.uid)).data.status == 'APPLIED'
            && (!exists(applicationDoc(seminarId + '__' + request.auth.uid))
                || get(applicationDoc(seminarId + '__' + request.auth.uid)).data.status == 'CANCELED'))
          // member releases a seat: own application becomes CANCELED in the same write
          || (request.resource.data.enrolled == resource.data.enrolled - 1
            && getAfter(applicationDoc(seminarId + '__' + request.auth.uid)).data.status == 'CANCELED'
            && get(applicationDoc(seminarId + '__' + request.auth.uid)).data.status in ['APPLIED', 'CONFIRMED'])
        ));
    }

    // Seminar applications: one per member per seminar ({seminarId}__{uid}).
    match /seminarApplications/{applicationId} {
      // `get` by id so a member's transaction can read their (possibly not yet existing)
      // application; ids always end in the owner's uid (enforced on create below).
      allow get: if isAdmin() || (request.auth != null && applicationId.matches('.*__' + request.auth.uid));
      allow list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow delete: if false;

      function validApplication(data) {
        return data.uid == request.auth.uid
          && applicationId == data.seminarId + '__' + request.auth.uid
          && data.status == 'APPLIED'
          && data.paymentStatus == 'UNPAID'
          && data.applicant.name is string && data.applicant.name.size() > 0 && data.applicant.name.size() <= 50
          && data.applicant.email is string && data.applicant.email.size() <= 200
          && data.amount == get(seminarDoc(data.seminarId)).data.price
          // the seat must be taken in the same write
          && getAfter(seminarDoc(data.seminarId)).data.enrolled == get(seminarDoc(data.seminarId)).data.enrolled + 1;
      }

      allow create: if request.auth != null && validApplication(request.resource.data);
      allow update: if isAdmin()
        // member re-applies after cancelling
        || (request.auth != null && resource.data.uid == request.auth.uid
            && resource.data.status == 'CANCELED'
            && request.resource.data.seminarId == resource.data.seminarId
            && validApplication(request.resource.data))
        // member cancels own application, releasing the seat in the same write
        || (request.auth != null && resource.data.uid == request.auth.uid
            && resource.data.status in ['APPLIED', 'CONFIRMED']
            && request.resource.data.status == 'CANCELED'
            && onlyChanged(['status', 'canceledBy', 'cancelReason', 'updatedAt'])
            && getAfter(seminarDoc(resource.data.seminarId)).data.enrolled
               == get(seminarDoc(resource.data.seminarId)).data.enrolled - 1);
    }

    match /agentWorkspaces/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.ownerUid == userId;

      match /{collectionName}/{recordId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.ownerUid == userId;
      }
    }

    // Member profile: read by the server for INDEX AI limits (api/_chatQuota.ts) and listed in
    // /admin/members. Members keep their own name/email/lastLoginAt current; memberType, role
    // (admin) and status (suspended) are set by admins only.
    match /members/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['memberType', 'company', 'createdAt', 'name', 'email', 'lastLoginAt', 'phone', 'provider'])
        && request.resource.data.memberType in ['일반회원', '사업자회원'];
      allow update: if isAdmin()
        || (request.auth != null
          && request.auth.uid == userId
          && onlyChanged(['name', 'email', 'lastLoginAt']));
      allow delete: if isAdmin();
    }

    // Board posts (사례 게시판 등): src/lib/posts.ts. Public sees visible posts; admins manage all.
    match /posts/{postId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.board in ['cases']
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && (!('body' in request.resource.data) || (request.resource.data.body is string && request.resource.data.body.size() <= 100000))
        && request.resource.data.visible is bool;
      allow delete: if isAdmin();
    }

    // Admin-editable site content (menus, page copy, partner list, footer…): src/lib/siteContent.ts.
    match /siteContent/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // chatUsage/{uid} (question counters) and kisconContractors / kisconSync are written
    // by the server with the Admin SDK only; there is no client access (no rule = denied).

    // ARCHI Agent Studio (src/archi): one record per document, per signed-in user.
    match /archiStudio/{userId}/{model}/{recordId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
