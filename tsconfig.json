{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@archi-web/*": ["./src/archi/web/*"],
      "@archi/db": ["./src/archi/db/index.ts"],
      "@archi/*": ["./src/archi/packages/*/index.ts"],
      "next/server": ["./src/archi/shims/next-server.ts"],
      "next/link": ["./src/archi/shims/next-link.tsx"],
      "next/navigation": ["./src/archi/shims/next-navigation.ts"],
      "next/font/google": ["./src/archi/shims/next-font-google.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
