{
  "name": "index-kiaa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "INDEX — 주거 실내건축 전문가의 지식 교류와 공간 혁신",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "archi:schema": "node scripts/gen-archi-schema.mjs",
    "test:wiki": "node scripts/test-wiki.mjs",
    "kiscon:backfill": "esbuild scripts/kiscon-backfill.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/kiscon-backfill.mjs --log-level=warning && node --env-file-if-exists=.env.local node_modules/.cache/kiscon-backfill.mjs",
    "wiki:server": "node server/wiki/server.mjs",
    "meetings:server": "node --import tsx server/meetings/server.mjs",
    "wiki:mercury": "node scripts/start-index-mercury.mjs",
    "wiki:build": "npm run build && node scripts/build-knowledge-runtime.mjs",
    "test:knowledge": "node --test scripts/test-knowledge-runtime.mjs",
    "wiki:backup": "node scripts/backup-knowledge.mjs",
    "wiki:backup:github": "node scripts/backup-wiki-github.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.13",
    "@assistant-ui/react": "^0.14.26",
    "@assistant-ui/react-ai-sdk": "^1.3.40",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@astryxdesign/core": "^0.1.5",
    "@astryxdesign/theme-neutral": "^0.1.5",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource/black-han-sans": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@react-sigma/core": "6.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "ai": "^7.0.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.10.0",
    "graphology": "0.26.0",
    "graphology-layout": "0.6.1",
