    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-force-graph-3d": "1.29.2",
    "react-icons": "^5.7.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^6.26.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "sigma": "4.0.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "three": "0.187.0",
    "three-spritetext": "1.10.0",
    "tw-animate-css": "^1.4.0",
