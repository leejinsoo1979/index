VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
FIREBASE_PROJECT_ID=
ADMIN_EMAILS=sbbc212@gmail.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
MEM0_API_KEY=

# ARCHI Agent Studio (/agent-studio) — api/archi-llm.ts
# Encrypts provider API keys registered in Studio settings (16+ chars, e.g. `openssl rand -base64 32`).
ARCHI_KEY_SECRET=
# Optional server-wide fallback keys/models used when a workspace has no key registered.
ARCHI_OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Public regulation / building data for the chatbots (api/_regulations.ts). Each is optional;
# tools for a source appear only when its key is set.
# 법제처 국가법령정보 공동활용 (open.law.go.kr) OC 값. The calling server's IP/domain must be registered there.
LAW_OC=
# 공공데이터포털 일반 인증키 (Encoding/Decoding either works). 활용신청: 건축HUB 건축물대장정보, 건축HUB 건축인허가정보, 토지이용규제정보서비스.
DATA_GO_KR_SERVICE_KEY=
# 도로명주소 검색 API 승인키 (business.juso.go.kr) — address → 법정동코드/지번 for the data.go.kr lookups.
JUSO_API_KEY=
# 국가건설기준센터 KDS·KCS Open API 키 (kcsc.re.kr).
KCSC_API_KEY=
# 건설업 등록(면허) 색인 — 키스콘 공시를 Firestore에 동기화 (api/_kiscon.ts). Uses DATA_GO_KR_SERVICE_KEY
# (활용신청: 국토교통부_키스콘 건설업체정보 서비스) plus a Firebase service account JSON (raw or base64).
FIREBASE_SERVICE_ACCOUNT=
# Vercel Cron sends this as a Bearer token to /api/kiscon-sync.
CRON_SECRET=
# 법제처는 등록된 서버 IP만 응답한다 — Vercel Hobby는 고정 IP가 없으므로 고정 IP 서버의 relay/law-relay.mjs를 거친다.
LAW_RELAY_URL=
LAW_RELAY_SECRET=
# Optional: run the home chatbot (/api/chat) on an OpenAI-compatible server instead of OpenAI,
# e.g. a local Ollama during `npm run dev` (put these in .env.local).
CHAT_LLM_BASE_URL=
CHAT_LLM_MODEL=
# Model routing for /api/chat: OPENAI_MODEL (light, default gpt-5.4-nano) for everyday and wiki-answerable
# questions, OPENAI_MODEL_HEAVY (default gpt-5.4-mini) for regulation/address/business lookups.
OPENAI_MODEL_HEAVY=
# INDEX 위키 owners whose 검수 완료 pages ground the chatbot (default: the ADMIN_EMAILS users). Needs FIREBASE_SERVICE_ACCOUNT.
WIKI_OWNER_UIDS=

# INDEX shared knowledge runtime (Node 24; no secrets are sent to the browser).
INDEX_KNOWLEDGE_DIR=.index-knowledge
WIKI_PORT=5318
# Optional Wiki-only overrides; otherwise reuse CHAT_LLM_* / OPENAI_* settings.
WIKI_LLM_BASE_URL=
WIKI_LLM_MODEL=
WIKI_LLM_API_KEY=
